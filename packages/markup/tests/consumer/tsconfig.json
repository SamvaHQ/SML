{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@samva/markup/*": ["../../dist/*.d.ts"]
    },
    "jsx": "react-jsx"
  },
  "include": ["./*.ts", "./*.tsx", "../../samva-brand.d.ts"]
}
