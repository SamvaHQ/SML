{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "jsx-a11y", "node"],
  "jsPlugins": [
    {
      "name": "samva",
      "specifier": "./scripts/oxlint-plugin-samva.js"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "import/namespace": "off",
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "off",
    "react/rules-of-hooks": "error",
    "react/button-has-type": "error",
    "react/no-unstable-nested-components": "off",
    "typescript/no-extraneous-class": "off",
    "eslint/no-unused-vars": [
      "error",
      {
        "args": "none",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "react-hooks/exhaustive-deps": "error",
    "typescript/no-this-alias": "error",
    "eslint/no-useless-escape": "error",
    "eslint/require-yield": "error",
    "react/no-children-prop": "error",
    "typescript/prefer-as-const": "error",
    "eslint/no-control-regex": "error",
    "eslint/no-unassigned-vars": "error",
    "node/no-process-env": "error",
    "eslint/no-await-in-loop": "error",
    "eslint/no-underscore-dangle": "off",
    "typescript/triple-slash-reference": "error",
    "jsx-a11y/anchor-has-content": "off",
    "jsx-a11y/anchor-is-valid": "off",
    "jsx-a11y/aria-unsupported-elements": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/heading-has-content": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/media-has-caption": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "typescript/no-explicit-any": "error",
    "samva/no-try-catch-or-throw": "error",
    "samva/no-error-constructor": "error",
    "samva/no-copy-string-selector": "error",
    "samva/no-hand-rolled-object-guard": "error",
    "samva/no-unsafe-type-assertion": "error"
  },
  "overrides": [
    {
      "files": [
        "**/{vite,vitest,oxlint}.config.{ts,mts,cts}",
        "scripts/**/*.{ts,js,mts,mjs}",
        "packages/*/scripts/**/*.{ts,js,mts,mjs}"
      ],
      "rules": {
        "node/no-process-env": "off",
        "samva/no-try-catch-or-throw": "off",
        "samva/no-error-constructor": "off"
      }
    },
    {
      "files": ["**/tests/**/*.{ts,tsx}"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["**/tests/**/*.{ts,tsx}"],
      "rules": {
        "react/globals": "off",
        "react/immutability": "off",
        "react/purity": "off"
      }
    },
    {
      "files": ["**/tests/**/*.{ts,tsx}", "**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}"],
      "rules": {
        "eslint/no-await-in-loop": "off",
        "samva/no-try-catch-or-throw": "off",
        "samva/no-error-constructor": "off"
      }
    },
    {
      "files": ["scripts/**/*.{ts,js,mts}", "packages/*/scripts/**/*.{ts,js,mts}"],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      "files": ["packages/markup/**/*.{ts,tsx}"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/no-array-index-key": "off",
        "react/rules-of-hooks": "off",
        "react/button-has-type": "off",
        "react/purity": "off",
        "react/refs": "off",
        "react/set-state-in-effect": "off",
        "react/no-unstable-nested-components": "off",
        "react/no-children-prop": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      "files": ["packages/editor/src/**/*.tsx", "packages/vite/editor/src/**/*.tsx"],
      "rules": {
        "react/only-export-components": [
          "error",
          {
            "allowConstantExport": true,
            "allowExportNames": ["Route"]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["node_modules", "dist", "build", "*.gen.ts", "packages/markup/src/json-schema"]
}
